# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test/coverage artifacts
coverage/
.vitest/

# --- Sensitive data guards -------------------------------------------------
# Doclyst processes personal data. Nothing produced by a real run should ever
# reach version control. Only files under packages/*/test/fixtures (which must
# contain synthetic data only) are intended to be committed.

# Default output directories used by the CLI and docs.
#
# Anchored to the repository root with a leading slash. Unanchored, `output/`
# also matches any nested directory of that name — which silently excluded the
# source directory `packages/core/src/output/`, leaving the pushed repository
# unbuildable while everything still passed locally.
/out/
/output/
/generated/
*.zip

# Generated by examples/make-example.mjs; not committed, so the repository
# holds no opaque binary files.
examples/offer-letter.docx
/letters/

# Real templates and datasets dropped into the repo while developing
/templates/
/data/
/samples/
*.local.csv
*.local.xlsx
*.local.docx
*.local.pdf

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Throwaway scripts written at the repository root while investigating.
#
# Three of these were committed by accident: they import from `dist/` and read
# from `/tmp`, so they are broken for anyone else and belong to nobody. Every
# real script in this repository lives in a package or in `examples/`, so
# nothing at the root is a loss.
/*.mjs
!/*.config.mjs

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
